# Copy to .env and replace secrets before any deployment.
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://pharmaos:pharmaos@localhost:55432/pharmaos?sslmode=disable
TEST_DATABASE_URL=postgres://pharmaos:pharmaos@localhost:55433/pharmaos_test?sslmode=disable
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
PASSWORD_HASH_COST=12
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006
RATE_LIMIT_PER_MIN=300
RATE_LIMIT_BACKEND=postgres
TRUSTED_PROXIES=
MIGRATIONS_DIR=./migrations
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=15s
WEBHOOK_WORKER_INTERVAL=5s
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_TIMEOUT=10s
ALLOW_INSECURE_WEBHOOKS=true
